NEXT_PUBLIC_FACEBOOK_PIXEL_ID=646040297652269
# Create a Turnstile widget for each site hostname in Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-side only. Do not expose this key with the NEXT_PUBLIC_ prefix.
TURNSTILE_SECRET_KEY=

# Zoho CRM administrator portal. Keep every value below server-side only.
# Grant ZohoCRM.users.READ to the refresh token used by this server.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=https://www.zohoapis.com
# Optional. Defaults to the Zoho Accounts domain matching ZOHO_API_DOMAIN.
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
# Register this exact URL as an allowed redirect URI in the Zoho OAuth client.
ZOHO_REDIRECT_URI=https://www.yegmy.com/api/admin/auth/callback
# Use a cryptographically random value of at least 32 characters.
ZOHO_SESSION_SECRET=
